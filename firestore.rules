rules_version = '2';

// 誰が何を読み書きできるかの決まりです。SETUP.md の手順4で、Firebase の「ルール」画面に貼り付けます。
//  店長   : 自分の店の設定・全員の希望・メンバーを見られる／直せる
//  スタッフ: 自分の希望だけ読み書きできる（他の人の希望は見えない）
//  店コードを知っている人だけが、その店のスタッフとして参加できる
//  シフト表 : 下書きは店長だけ。公開した表は、店のスタッフ全員が見られる
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function storePath(storeId) { return /databases/$(database)/documents/stores/$(storeId); }
    function isManager(storeId) {
      return signedIn() && get(storePath(storeId)).data.managerUid == request.auth.uid;
    }
    function isMember(storeId) {
      return signedIn() && exists(/databases/$(database)/documents/stores/$(storeId)/members/$(request.auth.uid));
    }
    function notAnonymous() { return request.auth.token.firebase.sign_in_provider != 'anonymous'; }

    match /stores/{storeId} {
      // 店の作成：メールで登録した店長だけ。店コード（storeId）は8文字
      allow create: if signedIn() && notAnonymous()
                    && request.resource.data.managerUid == request.auth.uid
                    && storeId.size() == 8
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 40;
      allow get: if signedIn() && (resource.data.managerUid == request.auth.uid || isMember(storeId));
      allow list: if signedIn() && resource.data.managerUid == request.auth.uid;
      allow update: if isManager(storeId)
                    && request.resource.data.managerUid == resource.data.managerUid;
      allow delete: if false;

      match /members/{uid} {
        // 自分の情報か、店長だけが読める
        allow read: if isManager(storeId) || (signedIn() && request.auth.uid == uid);
        // 店コード（＝店のID）を知っていれば、自分をスタッフとして追加できる
        allow create: if signedIn() && request.auth.uid == uid
                      && exists(storePath(storeId))
                      && request.resource.data.role == 'staff'
                      && request.resource.data.name is string
                      && request.resource.data.name.size() > 0
                      && request.resource.data.name.size() <= 40;
        allow update: if signedIn() && request.auth.uid == uid
                      && request.resource.data.role == resource.data.role;
        allow delete: if isManager(storeId) || (signedIn() && request.auth.uid == uid);
      }

      // シフトの下書き：店長だけ
      match /drafts/{ym} {
        allow read, write: if isManager(storeId);
      }
      // 公開したシフト表：店のスタッフ全員が見られる。書けるのは店長だけ
      match /schedules/{ym} {
        allow read: if isManager(storeId) || isMember(storeId);
        allow write: if isManager(storeId);
      }

      match /requests/{reqId} {
        // 書類のIDは「2026-11_ユーザーID」の形。自分の分だけ読める。店長は全部読める
        allow read: if isManager(storeId)
                    || (isMember(storeId) && reqId.matches('^[0-9]{4}-[0-9]{2}_' + request.auth.uid + '$'));
        allow create, update: if isMember(storeId)
                    && request.resource.data.uid == request.auth.uid
                    && reqId == request.resource.data.ym + '_' + request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 40;
        allow delete: if isManager(storeId)
                    || (isMember(storeId) && reqId.matches('^[0-9]{4}-[0-9]{2}_' + request.auth.uid + '$'));
      }
    }
  }
}
